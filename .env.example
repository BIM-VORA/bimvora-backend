# ============================================================
# BIMVORA Backend — Environment Variables
# Copy this file to .env and fill in the values.
# All variables are required unless marked (optional).
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=production
DEBUG=false

# ── Database ─────────────────────────────────────────────────
# Use postgresql+asyncpg:// — the config.py auto-converts to
# postgresql+psycopg2:// for Alembic migrations automatically.
#
# EasyPanel internal hostname for PostgreSQL is usually: postgres
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://bimvora:YOUR_PASSWORD@postgres:5432/bimvora

# ── Supabase Storage ─────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=bimvora-files

# ── Stripe ───────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/webhooks → Add endpoint
# Endpoint URL: https://api.bimvora.com/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ───────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=orders@bimvora.com

# ── Frontend (CORS) ──────────────────────────────────────────
FRONTEND_URL=https://bimvora.com

# ── Internal Security ────────────────────────────────────────
# Must match INTERNAL_SECRET in frontend .env
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=changeme-generate-a-random-32-char-string

# ── Tracking — Meta Conversions API ─────────────────────────
# Get Pixel ID from: Events Manager → Pixel → Settings
# Get Access Token from: Events Manager → Pixel → Settings → Conversions API
META_PIXEL_ID=
META_ACCESS_TOKEN=

# ── Tracking — TikTok Events API ────────────────────────────
# Get from: TikTok Ads Manager → Assets → Events → Manage → Web Events
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ── Tracking — LinkedIn CAPI ─────────────────────────────────
# Get from: Campaign Manager → Account Assets → Insight Tag
LINKEDIN_PARTNER_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CONVERSION_ID=

# ── Tracking — Google Analytics 4 ───────────────────────────
# Measurement ID from: GA4 → Admin → Data Streams → Web stream details
# API Secret from: GA4 → Admin → Data Streams → Measurement Protocol API secrets
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=

# ── Google Sheets (optional) ─────────────────────────────────
# Deploy the Apps Script from /sheets/webhook.gs as a web app
# and paste the URL here.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
SHEETS_SECRET=changeme-sheets-secret

# ── Admin ────────────────────────────────────────────────────
# API key for admin endpoints. Also used as JWT secret key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=changeme-generate-a-random-admin-key
